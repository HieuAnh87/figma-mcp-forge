{
  "name": "figma-mcp-forge",
  "version": "0.1.0",
  "description": "Read, edit, and audit live Figma and FigJam documents from MCP clients; includes the matching Figma plugin.",
  "type": "module",
  "bin": {
    "figma-mcp-forge": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "plugin/manifest.json",
    "plugin/dist/code.js",
    "plugin/dist/index.html",
    "FORGE.md",
    "LICENSE.md",
    "RELEASING.md",
    "plugin/forge-release.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js",
    "prepack": "node ../scripts/prepare-package.mjs"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HieuAnh87/figma-mcp-forge.git",
    "directory": "server"
  },
  "homepage": "https://github.com/HieuAnh87/figma-mcp-forge#readme",
  "bugs": {
    "url": "https://github.com/HieuAnh87/figma-mcp-forge/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@figma/plugin-typings": "^1.140.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
